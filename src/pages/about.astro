---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Link from "../components/Link.astro";
import Hex from "../components/Hex.astro";

const lastUpdated = __BUILD_DATE__;
---

<Layout pageTitle="About">
    <main class="about">
        <div class="about__me">
            <h1 class="about__heading loud">The Man</h1>

            <div class="about__content">
                <Section title="Interests" compact>
                    <p>I love calisthenics, guitars, books, tennis, and Linux!</p>
                </Section>

                <Section title="Some Principles" compact>
                    <ol class="about__principles">
                        <li>
                            Use Simplified Technical English{" "}
                            <sup class="reference md">
                                <Link href="https://wikipedia.org/wiki/Simplified_Technical_English"></Link>
                            </sup>
                        </li>
                        <li>Question your coding agents</li>
                        <li>
                            Strive for self-documenting code{" "}
                            <sup class="reference md">
                                <Link href="https://wikipedia.org/wiki/Self-documenting_code"></Link>
                            </sup>
                        </li>
                        <li>Debloat everything you can</li>
                    </ol>
                </Section>

                <Section title="Contact" compact>
                    <p>
                        Feel free to reach out via{" "}
                        <Link href="https://www.linkedin.com/in/edu-floram">LinkedIn</Link> or{" "}
                        <Link href="mailto:eduardo.floresramones@gmail.com">email</Link> and check out my{" "}
                        <Link href="/resume.pdf">resume</Link>.
                    </p>
                </Section>
            </div>
        </div>

        <div class="about__site">
            <h1 class="about__heading loud">The Website</h1>

            <div class="about__content">
                <Section title="Colophon" compact>

                    <div class="about__colophon">
                        <p>
                            <b>Stack:</b> Astro, TypeScript, CSS
                        </p>
                        <p>
                            <b>Style:</b> Inter typeface
                            {" "}<Hex color="--bg" />
                            {" "}<Hex color="--fg" />
                            {" "}<Hex color="--fg-muted" />
                            {" "}<Hex color="--highlight" />
                        </p>
                    </div>

                    <p>
                        Explore the site's{" "}
                        <Link href="https://github.com/edu-flores/edu-flores.github.io">source code</Link> and{" "}
                        <Link href="/">traffic analytics</Link>.
                    </p>
                </Section>

                <Section title="Background" compact>
                    <p>
                        The [desktop] background runs{" "}
                        <Link href="https://wikipedia.org/wiki/Conway%27s_Game_of_Life">Conway's Game of Life</Link>{" "}
                        cellular automaton; it uses the <i>Coagulations</i>{" "}
                        <sup class="reference md">
                            <Link href="https://conwaylife.com/wiki/OCA:Coagulations"></Link>
                        </sup> rulestring, and cells can also randomly perish.
                    </p>
                </Section>

                <div class="about__dates">
                    <p>Created: October 2026</p>
                    {lastUpdated && <p>Updated: {lastUpdated}</p>}
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .about {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .about__heading {
        font-size: 24px;
        margin-bottom: 1rem;
    }

    .about__dates {
        font-size: 14px;
    }

    .about__colophon {
        margin-bottom: 1rem;
    }

    .about__content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .about__principles {
        line-height: 24px;
    }

    /* References */

    .about {
        counter-reset: reference;
    }

    .about :global(sup.reference) {
        counter-increment: reference;
        position: relative;
        top: -5px;
        vertical-align: baseline;
    }

    .about :global(sup.reference a::before) {
        content: "[" counter(reference) "]";
        font-size: 12px;
    }
</style>
