---
import SunIcon from "../assets/icons/sun.svg";
import MoonIcon from "../assets/icons/moon.svg";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<nav>
    <button id="logo">
        <span><b>E</b>F</span>
    </button>

    <div id="links">
        <a href="/about" class:list={{ active: currentPath === "about" }}>About</a>
        <a href="/projects" class:list={{ active: currentPath === "projects" }}>Projects</a>
        <a href="/other" class:list={{ active: currentPath === "other" }}>Other</a>

        <button id="theme-toggle" class="flex">
            <SunIcon class="theme-icon light-icon highlightable" width="22" height="22" />
            <MoonIcon class="theme-icon dark-icon highlightable" width="22" height="22" />
        </button>
    </div>
</nav>

<style>
    #logo {
        font-size: 18px;
    }

    nav {
        display: flex;
        justify-content: space-between;
    }

    #links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    #links a {
        transition: color 0.25s ease;
    }

    #links a.active {
        color: var(--fg);
        font-weight: bold;
    }

    #links a:hover {
        color: var(--fg);
    }

    .theme-icon {
        display: none;
    }

    :global(html[data-theme="light"]) .dark-icon {
        display: block;
    }

    :global(html[data-theme="dark"]) .light-icon {
        display: block;
    }
</style>

<script>
    const button = document.querySelector("#theme-toggle");

    button?.addEventListener("click", () => {
        const html = document.documentElement;
        const currentTheme = html.dataset.theme;
        html.dataset.theme = currentTheme === "dark" ? "light" : "dark";
        localStorage.setItem("theme", html.dataset.theme);
    });
</script>
