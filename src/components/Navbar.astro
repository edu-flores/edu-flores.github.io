---
import SettingsIcon from "../assets/icons/settings.svg";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<nav>
    <button id="highlight-wave">
        <b>ed</b>fl
    </button>

    <div id="links">
        <a href="/about" class:list={{ active: currentPath === "about" }}>About</a>
        <a href="/projects" class:list={{ active: currentPath === "projects" }}>Projects</a>
        <a href="/other" class:list={{ active: currentPath === "other" }}>Other</a>

        <button class="flex">
            <SettingsIcon stroke="var(--fg)" width="22" height="22" />
        </button>
    </div>
</nav>

<style>
    nav {
        display: flex;
        justify-content: space-between;
    }

    #links {
        text-transform: lowercase;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    #links a {
        transition: color 0.25s ease;
    }

    #links a.active {
        color: var(--fg);
        font-weight: bold;
    }

    #links a:hover {
        color: var(--fg);
    }
</style>
