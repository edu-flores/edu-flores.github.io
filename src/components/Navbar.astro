---
import SunIcon from "../assets/icons/sun.svg";
import MoonIcon from "../assets/icons/moon.svg";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<nav>
    <button id="logo">
        <span><b>E</b>F</span>
    </button>

    <div id="links">
        <a
            href="/about"
            class="highlightable"
            class:list={{ active: currentPath === "about" }}
        >
            About
        </a>
        <a
            href="/projects"
            class="highlightable"
            class:list={{ active: currentPath === "projects" }}
        >
            Projects
        </a>
        <a
            href="/more"
            class="highlightable"
            class:list={{ active: currentPath === "more" }}
        >
            More
        </a>

        <button id="theme-toggle" class="flex highlightable">
            <SunIcon id="light-icon" width="24" height="24" />
            <MoonIcon id="dark-icon" width="24" height="24" />
        </button>
    </div>
</nav>

<style>
    #logo {
        font-size: 18px;
    }

    nav {
        display: flex;
        justify-content: space-between;
    }

    #links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    #links a {
        transition: color 0.25s ease;
    }

    #links a.active {
        color: var(--fg);
        font-weight: bold;
    }

    :global(html[data-theme="light"]) #light-icon {
        display: none;
    }

    :global(html[data-theme="dark"]) #dark-icon {
        display: none;
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        const button = document.querySelector("#theme-toggle");

        button?.addEventListener("click", () => {
            const html = document.documentElement;
            const currentTheme = html.dataset.theme;
            html.dataset.theme = currentTheme === "dark" ? "light" : "dark";
            localStorage.setItem("theme", html.dataset.theme);
        });
    });
</script>
