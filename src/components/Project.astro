---
import { Image } from "astro:assets";

import SourceIcon from "../assets/icons/source.svg";
import ExternalIcon from "../assets/icons/external.svg";

interface Props {
    image: ImageMetadata;
    title: string;
    source: string;
    external: string;
    description: string;
    tags: string[];
    date: string;
}

const { image, title, source, external, description, tags, date } = Astro.props;
---

<article class="project">
    <a href={external} target="_blank" class="project-image">
        <Image src={image} alt={title} layout="fixed" width={image.width} height={image.height} />
    </a>

    <div class="project-content">
        <header class="project-header">
            <h2 class="loud">{title}</h2>

            <nav class="project-links">
                <a href={source} target="_blank">
                    <SourceIcon class="highlightable" width="24" height="24" />
                </a>
                <a href={external} target="_blank">
                    <ExternalIcon class="highlightable" width="24" height="24" />
                </a>
            </nav>
        </header>
    
        <p set:html={description}></p>
    
        <footer class="project-meta">
            <ul class="project-tags">
                {tags.map((tag: string) => <li class="project-tag elevate">{tag}</li>)}
            </ul>
            <time class="project-date sm" datetime={date}>
                {date}
            </time>
        </footer>
    </div>
</article>

<style>
    .project {
        margin-bottom: 2rem;
    }

    .project-image {
        display: block;
        aspect-ratio: 16 / 10;
        margin-bottom: 1rem;
        border-radius: 5px;
        overflow: hidden;
    }

    .project-image img {
        width: 100%;
        height: 100%;
        transition: transform 0.5s ease;
    }

    .project-image:hover img {
        transform: scale(1.02);
    }

    .project-content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .project-links {
        display: flex;
        gap: 0.5rem;
    }

    .project-meta {
        display: flex;
        justify-content: space-between;
    }

    .project-tags {
        list-style-type: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .project-tag {
        border: 1px solid var(--fg);
        padding: 5px 8px;
        border-radius: 5px;
        font-size: small;
    }

    .project-date {
        display: flex;
        align-items: center;
        font-size: 14px;
    }
</style>
