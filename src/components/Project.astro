---
import { Image } from "astro:assets";

import SourceIcon from "../assets/icons/source.svg";
import ExternalIcon from "../assets/icons/external.svg";

interface Props {
    image: ImageMetadata;
    title: string;
    source: string;
    external: string;
    description: string;
    tags: string[];
    date: string;
}

const { image, title, source, external, description, tags, date } = Astro.props;
---

<article>
    <a href={external} target="_blank" rel="noopener" class="project__image">
        <Image src={image} alt="" layout="fixed" width={image.width} height={image.height} />
    </a>

    <div class="project__content">
        <header class="project__header">
            <h2 class="loud">{title}</h2>

            <div class="project__links">
                <a href={source} target="_blank" rel="noopener" aria-label="Source code">
                    <SourceIcon class="highlightable" width="24" height="24" />
                </a>
                <a href={external} target="_blank" rel="noopener" aria-label="View project">
                    <ExternalIcon class="highlightable" width="24" height="24" />
                </a>
            </div>
        </header>
    
        <p set:html={description}></p>
    
        <footer class="project__meta">
            <ul class="project__tags">
                {tags.map((tag: string) => <li class="project__tag elevate">{tag}</li>)}
            </ul>
            <span class="project__date sm">
                {date}
            </span>
        </footer>
    </div>
</article>

<style>
    .project__image {
        display: block;
        aspect-ratio: 16 / 10;
        margin-bottom: 1rem;
        border-radius: 5px;
        overflow: hidden;
    }

    .project__image img {
        width: 100%;
        height: 100%;
        transition: transform 0.5s ease;
    }

    .project__image:hover img {
        transform: scale(1.02);
    }

    .project__content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .project__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .project__links {
        display: flex;
        gap: 0.5rem;
    }

    .project__meta {
        display: flex;
        justify-content: space-between;
    }

    .project__tags {
        list-style-type: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .project__tag {
        border: 1px solid var(--fg);
        padding: 5px 8px;
        border-radius: 5px;
        font-size: 13px;
    }

    .project__date {
        display: flex;
        align-items: center;
        font-size: 14px;
    }
</style>
