---
const { title } = Astro.props;
---

<section>
    <h2>{title}</h2>

    <div id={title.toLowerCase().replaceAll(" ", "-")}>
        <slot />
    </div>
</section>

<style>
    h2 {
        font-size: 18px;
        font-weight: normal;
        margin-bottom: 1rem;
    }

    #technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
    }
</style>
