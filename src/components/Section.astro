---
interface Props {
    title: string;
    compact?: boolean;
}

const { title, compact = false } = Astro.props;
---

<section>
    <h2 class:list={["section__heading", "loud", { compact }]}>{title}</h2>

    <slot />
</section>

<style>
    .section__heading {
        font-size: 18px;
        font-weight: normal;
        margin-bottom: 1rem;
    }

    .section__heading.compact {
        margin-bottom: 0.5rem;
    }
</style>
