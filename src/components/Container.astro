---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
---

<div class="container">
    <Navbar />
    <slot />
    <Footer />
</div>

<style>
    .container {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 3rem;
        position: relative;
        background-color: var(--bg);
        isolation: isolate;
        max-width: 42rem;
        min-height: 100vh;
        margin-inline: auto;
        padding: 1rem 2rem;
    }

    /* Layer to hide middle canvas on overscrolls */
    .container::before {
        content: "";
        background: inherit;
        position: fixed;
        inset: 0;
        width: min(42rem, 100%);
        margin-inline: auto;
        pointer-events: none;
        z-index: -1;
    }
</style>
