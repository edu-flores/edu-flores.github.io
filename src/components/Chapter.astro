---
import { Image } from 'astro:assets';

const { image, link, primary, secondary, period } = Astro.props;
---

<div id="chapter">
    <div class="flex">
        <a href={link} target="_blank">
            <Image src={image} alt="Logo" width="20" height="20" />
            <span><b>{primary}</b></span>
        </a>
        <span id="secondary">{secondary}</span>
    </div>

    <span id="period" class="sm">{period}</span>
</div>

<style>
    #chapter {
        display: flex;
        justify-content: space-between;
    }

    #chapter:not(:last-child) {
        margin-bottom: 0.5rem;
    }

    a {
        display: flex;
        gap: 0.5rem;
    }

    #secondary::before {
        content: "|";
        margin-inline: 0.5rem;
    }

    #period {
        font-size: 14px;
    }
</style>
