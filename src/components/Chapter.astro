---
import { Image } from 'astro:assets';

const { image, link, primary, secondary, period } = Astro.props;
---

<div id="chapter">
    <Image src={image} alt="Logo" width="20" height="20" />
    <div id="text">
        <span><b><a href={link} target="_blank">{primary}</a></b> | {secondary}</span>
        <span>{period}</span>
    </div>
</div>

<style>
    #chapter {
        display: flex;
        gap: 0.5rem;
    }

    #chapter:not(:last-child) {
        margin-bottom: 0.5rem;
    }

    #text {
        display: flex;
        justify-content: space-between;
        width: 100%;
    }
</style>
