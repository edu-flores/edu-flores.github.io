---
import GithubIcon from "../assets/icons/github.svg";
import LinkedinIcon from "../assets/icons/linkedin.svg";
import MailIcon from "../assets/icons/mail.svg";
---

<footer>
    <a
        href="https://github.com/edu-flores"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
    >
        <GithubIcon class="highlightable" width="24" height="24" />
    </a>
    <a
        href="https://www.linkedin.com/in/edu-floram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
    >
        <LinkedinIcon class="highlightable" width="24" height="24" />
    </a>
    <a
        href="mailto:eduardo.floresramones@gmail.com"
        aria-label="Email"
    >
        <MailIcon class="highlightable" width="24" height="24" />
    </a>
</footer>

<style>
    footer {
        margin-inline: auto;
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
    }
</style>
