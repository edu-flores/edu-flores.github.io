---
import GithubIcon from "../assets/icons/github.svg";
import LinkedinIcon from "../assets/icons/linkedin.svg";
import MailIcon from "../assets/icons/mail.svg";
---

<footer>
    <a href="https://github.com/edu-flores">
        <GithubIcon stroke="var(--fg)" width="22" height="22" />
    </a>
    <a href="https://www.linkedin.com/in/edu-floram">
        <LinkedinIcon stroke="var(--fg)" width="22" height="22" />
    </a>
    <a href="mailto:eduardo.floresramones@gmail.com">
        <MailIcon stroke="var(--fg)" width="22" height="22" />
    </a>
</footer>

<style>
    footer {
        margin-inline: auto;
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
    }
</style>
